#membuat list dan tuple
import sys

data_list=[10,20,30]
data_tuple=(10,20,30)
#menampilkan alamat memori objek
print("alamat memori list:",id(data_list))
print("alamat memori tuple:",id(data_tuple))
# menampilkan alamat memori tiap elemen di dalam list/tuple
print("\nAlamat memori elemen ke-0 pada list:",id(data_list[0]))
print("\nAlamat memori elemen ke-0 pada tuple:",id(data_tuple[0]))

print("ukuran memori list:",sys.getsizeof(data_list),"byte")
print("ukuran memori tuple:",sys.getsizeof(data_tuple),"byte")